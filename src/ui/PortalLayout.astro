---
/**
 * core/src/ui/PortalLayout.astro — the shared signed-in portal shell.
 *
 * Presentation only. It renders whatever nav model, branding, labels and org
 * context the consuming portal hands it; it knows nothing about any specific
 * portal's routes, tiers, price ladder or locales. Each portal wraps this with
 * a thin layout of its own (see logistics-portal/src/layouts/PortalLayout.astro)
 * that resolves those values and passes them down.
 *
 * Data fetching lives in the wrapper, not here — org/accent resolution is
 * @core/ui/org-context.ts, so a portal that does not use Clerk orgs simply
 * omits the `org` prop.
 *
 * Slots:
 *   default        page content
 *   topbar-extra   rendered in the top bar before the user button
 *                  (logistics puts its language toggle here)
 *   modals         rendered just above <main> (workspace-setup modal, etc.)
 */
import { UserButton } from '@clerk/astro/components';
import Analytics from "@vercel/analytics/astro";
import type { PortalNav, PortalNavItem } from './portal-nav.ts';
import { isActiveHref, isItemActive, currentActFor } from './portal-nav.ts';
import type { AccentPalette } from './accent-color.ts';
import SeoHead from './SeoHead.astro';

export interface PortalBrand {
  /** Appended to the page title: "<title> — <titleSuffix>". */
  titleSuffix: string;
  /** Sidebar logo, used when the org has no logo of its own. */
  logoSrc: string;
  /** Small wordmark for the mobile top bar. */
  wordmarkSrc: string;
  /**
   * Mark shown in the "Powered by" footer. Defaults to wordmarkSrc, which is
   * right for the flagship portal but wrong for a sub-brand — there it would
   * read "Powered by <itself>".
   */
  poweredBySrc?: string;
  /** Short context label under the sidebar logo. */
  callout?: string | null;
}

export interface PortalOrgContext {
  imageUrl?: string | null;
  name?: string | null;
  accentPalette?: AccentPalette | null;
  isComped?: boolean;
}

interface Props {
  title: string;
  /** Meta description. Only meaningful on a page that also sets `indexable`. */
  description?: string;
  /**
   * Opt this page into indexing. Defaults false, so the portal shell stays
   * noindex as it always has and no consuming portal changes behaviour by
   * upgrading core. A public marketing page passes true.
   */
  indexable?: boolean;
  /** Social card image for this page, root-relative or absolute. */
  socialImage?: string;
  /**
   * Overrides the derived canonical. Pass when this page duplicates another
   * URL's content and that other URL is the one that should rank.
   */
  canonical?: string;
  /** schema.org data for this page — see SeoHead. */
  jsonLd?: object | object[];
  isSignedIn?: boolean;
  /** Built by the portal — see @core/ui/portal-nav for the shape. */
  nav: PortalNav;
  bottomNav?: PortalNavItem[];
  brand: PortalBrand;
  org?: PortalOrgContext;
  /** Rendered into <html lang>. */
  lang?: string;
  /** Chrome strings the portal may translate. */
  labels?: { signIn?: string; help?: string };
  analytics?: { clarityId?: string | null; linkedInPartnerId?: string | null };
  /** Tenant builds send locked items to /start instead of /pricing. */
  isTenant?: boolean;
  legalLinks?: Array<{ label: string; href: string }>;
  poweredByHref?: string;
  /** Accessible name for the "Powered by" mark. */
  poweredByLabel?: string;
  /** Top-bar help link. Pass null to omit it on portals with no help centre. */
  helpHref?: string | null;
}

const {
  title,
  description = '',
  indexable = false,
  socialImage,
  canonical,
  jsonLd,
  isSignedIn = false,
  nav,
  bottomNav = [],
  brand,
  org = {},
  lang = 'en',
  labels: labelsProp = {},
  analytics = {},
  isTenant = false,
  legalLinks = [],
  poweredByHref = 'https://www.knowledgebricks.com',
  poweredByLabel = 'KnowledgeBricks',
  helpHref = '/help',
} = Astro.props;

const labels = { signIn: 'Sign in', help: 'Help', ...labelsProp };

const orgImageUrl = org.imageUrl ?? null;
const resolvedOrgName = org.name ?? null;
const accentPalette = org.accentPalette ?? null;
const isComped = org.isComped === true;

const path = Astro.url.pathname;

// Route-matching and act resolution are shared rules — see @core/ui/portal-nav.
const isActive = (href: string, exact = false) => isActiveHref(path, href, exact);
const currentAct = currentActFor(path, nav);

const defaultLockHref = isTenant ? '/start' : '/pricing?upgrade=principal';
---

<!DOCTYPE html>
<html lang={lang} style={accentPalette ? `--lp-indigo:${accentPalette.accent};--lp-indigo-deep:${accentPalette.deep};--lp-indigo-tint:${accentPalette.tint};--portal-accent:${accentPalette.accent};--portal-accent-bg:${accentPalette.tint}` : undefined} data-accent-cached={accentPalette ? "1" : undefined}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — {brand.titleSuffix}</title>
  <SeoHead
    title={`${title} — ${brand.titleSuffix}`}
    description={description}
    image={socialImage}
    canonical={canonical}
    jsonLd={jsonLd}
    noindex={!indexable}
    siteName={brand.titleSuffix}
  />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
  <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
  <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=instrument-sans@400,500,600,700&display=swap" />
  <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=geist-mono@400,500&display=swap" />
  <Analytics />
  {import.meta.env.PROD && analytics.clarityId && (
    <script is:inline set:html={`(function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", ${JSON.stringify(analytics.clarityId)});`} />
  )}
  {import.meta.env.PROD && analytics.linkedInPartnerId && (
    <script is:inline set:html={`_linkedin_partner_id = ${JSON.stringify(analytics.linkedInPartnerId)};
window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
window._linkedin_data_partner_ids.push(_linkedin_partner_id);
(function(l) {
  if (!l){window.lintrk = function(a,b){window.lintrk.q.push([a,b])};
  window.lintrk.q=[]}
  var s = document.getElementsByTagName("script")[0];
  var b = document.createElement("script");
  b.type = "text/javascript";b.async = true;
  b.src = "https://snap.licdn.com/li.lms-analytics/insight.min.js";
  s.parentNode.insertBefore(b, s);})(window.lintrk);`} />
  )}

  {/* Client accent extraction from the org logo (runs once when not cached).
      logoUrl is passed via <meta> so no values are interpolated into script text. */}
  {isSignedIn && orgImageUrl && (
    <>
      <meta name="org-logo-url" content={orgImageUrl} />
      <script is:inline src="/scripts/extract-accent.js"></script>
    </>
  )}
</head>
<body class="portal-body">

<div class="portal-shell">

  <!-- ── Sidebar ───────────────────────────────────────────── -->
  <aside class="portal-sidebar" id="portal-sidebar" aria-label="Portal navigation">
    <div class="portal-sidebar-inner">

      <div class="portal-logo">
        <a href="/start" class="portal-logo-link">
          <div class="portal-logo-content">
            {orgImageUrl ? (
              <img
                src={orgImageUrl}
                alt={resolvedOrgName ?? 'Organization'}
                class="portal-logo-org-img"
              />
            ) : (
              <img src={brand.logoSrc} alt={brand.titleSuffix} class="portal-logo-img" />
            )}
            {isSignedIn && (
              <div class="portal-logo-meta">
                <span class="portal-logo-callout">{brand.callout}</span>
              </div>
            )}
          </div>
        </a>
      </div>

      <nav class="portal-nav">
        <a
          href={nav.dashboard.href}
          class:list={['portal-nav-item', isActive(nav.dashboard.href, nav.dashboard.exact) && 'portal-nav-item--active']}
          aria-current={isActive(nav.dashboard.href, nav.dashboard.exact) ? 'page' : undefined}
        >
          <span class="portal-nav-label">{nav.dashboard.displayLabel ?? nav.dashboard.label}</span>
        </a>

        {nav.groups.map((group) => (
          group.collapsible ? (
            <details
              class="portal-nav-group portal-kb-group"
              data-act={group.label}
              open={(group.defaultOpen || group.items.some((i) => isItemActive(path, i))) || undefined}
            >
              <summary
                class:list={['portal-nav-item', 'portal-kb-summary', group.items.some((i) => isItemActive(path, i)) && 'portal-nav-item--active']}
              >
                <span class="portal-nav-label">{group.displayLabel ?? group.label}</span>
                <svg class="portal-kb-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </summary>
              {group.items.length > 0 ? (
                <div class="portal-kb-items">
                  {group.items.map((item) => {
                    const active = isItemActive(path, item);
                    return (
                      <a
                        href={item.locked ? (item.lockHref ?? defaultLockHref) : item.href}
                        class:list={['portal-kb-item', active && 'portal-kb-item--active']}
                        aria-current={active ? 'page' : undefined}
                      >
                        <span>{item.displayLabel ?? item.label}</span>
                        {item.locked && (
                          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-label="Requires upgrade">
                            <rect x="3" y="11" width="18" height="11" rx="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                          </svg>
                        )}
                      </a>
                    );
                  })}
                </div>
              ) : (
                <p class="portal-kb-empty">{group.emptyText ?? 'Coming soon'}</p>
              )}
            </details>
          ) : (
          <div class="portal-nav-group" data-act={group.label}>
            <p class="portal-nav-group-label">{group.displayLabel ?? group.label}</p>
            {group.items.map((item) => {
              const active = isItemActive(path, item);
              return (
                <a
                  href={item.locked ? (item.lockHref ?? defaultLockHref) : item.href}
                  class:list={['portal-nav-item', active && 'portal-nav-item--active']}
                  aria-current={active ? 'page' : undefined}
                >
                  <span class="portal-nav-label">{item.displayLabel ?? item.label}</span>
                  {item.badge && <span class="portal-nav-badge">{item.badge}</span>}
                  {item.locked && (
                    <svg class="portal-nav-lock" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-label="Requires upgrade">
                      <rect x="3" y="11" width="18" height="11" rx="2"/>
                      <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                  )}
                </a>
              );
            })}
          </div>
          )
        ))}
      </nav>

      <div class="portal-sidebar-bottom">
        <div class="portal-bottom-nav">
          {bottomNav.map((item) => (
            <a
              href={item.locked ? (item.lockHref ?? defaultLockHref) : item.href}
              class:list={['portal-nav-item', isItemActive(path, item) && 'portal-nav-item--active']}
            >
              {item.displayLabel ?? item.label}
              {item.locked && (
                <svg class="portal-nav-lock" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-label="Requires Principal plan">
                  <rect x="3" y="11" width="18" height="11" rx="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
              )}
            </a>
          ))}
        </div>
        <div class="portal-legal-links">
          {legalLinks.map((l) => (
            <a href={l.href} class="portal-trust-link" set:html={l.label} />
          ))}
        </div>
        <a href={poweredByHref} target="_blank" rel="noopener noreferrer" class="portal-powered-by">
          <span class="portal-powered-by-label">Powered by</span>
          <img src={brand.poweredBySrc ?? brand.wordmarkSrc} alt={poweredByLabel} class="portal-sidebar-logo-img" />
        </a>
      </div>

    </div>
  </aside>

  <div class="portal-backdrop" id="portal-backdrop" aria-hidden="true"></div>

  <!-- ── Main column ──────────────────────────────────────── -->
  <div class="portal-main">

    <header class="portal-topbar">
      <div class="portal-topbar-left">
        <button
          class="portal-hamburger"
          id="portal-hamburger"
          type="button"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="portal-sidebar"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
        <span class="portal-topbar-wordmark">
          <img src={brand.wordmarkSrc} alt={brand.titleSuffix} class="portal-topbar-logo-img" />
        </span>
        <h1 class="portal-topbar-title">{title}</h1>
      </div>
      <div class="portal-topbar-right">
        {isSignedIn && isTenant && (
          <span class="portal-kb-badge" title="Enterprise knowledge base — your organization's dedicated private workspace">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <span class="portal-kb-badge-text">Enterprise KB</span>
          </span>
        )}
        {helpHref && (
        <a href={helpHref} class="portal-help-link" title={labels.help} aria-label={labels.help}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
        </a>
        )}
        <slot name="topbar-extra" />
        {isSignedIn
          ? <UserButton />
          : <a href="/sign-in" class="portal-signin-link">{labels.signIn}</a>
        }
      </div>
    </header>

    {isComped && (
      <div id="comped-banner" class="comped-banner" role="status">
        <span class="comped-banner-text">
          Your organization has complimentary access to {brand.titleSuffix}.
        </span>
        <button
          id="comped-banner-close"
          class="comped-banner-close"
          aria-label="Dismiss"
          type="button"
        >×</button>
      </div>
    )}
    <slot name="modals" />
    <main class="portal-content" data-act={currentAct ?? undefined}>
      <slot />
    </main>

  </div>
</div>

<script>
  const hamburger = document.getElementById('portal-hamburger');
  const sidebar   = document.getElementById('portal-sidebar');
  const backdrop  = document.getElementById('portal-backdrop');

  function openSidebar() {
    sidebar?.classList.add('portal-sidebar--open');
    backdrop?.classList.add('portal-backdrop--visible');
    hamburger?.setAttribute('aria-expanded', 'true');
  }
  function closeSidebar() {
    sidebar?.classList.remove('portal-sidebar--open');
    backdrop?.classList.remove('portal-backdrop--visible');
    hamburger?.setAttribute('aria-expanded', 'false');
  }

  hamburger?.addEventListener('click', () => {
    sidebar?.classList.contains('portal-sidebar--open') ? closeSidebar() : openSidebar();
  });
  backdrop?.addEventListener('click', closeSidebar);
  document.querySelectorAll('.portal-nav-item').forEach((link) => {
    link.addEventListener('click', () => { if (window.innerWidth < 768) closeSidebar(); });
  });

  // Comped banner session dismissal
  (function () {
    var banner = document.getElementById('comped-banner');
    if (!banner) return;
    if (sessionStorage.getItem('comped-dismissed')) {
      banner.style.display = 'none';
      return;
    }
    var closeBtn = document.getElementById('comped-banner-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        sessionStorage.setItem('comped-dismissed', '1');
        if (banner) banner.style.display = 'none';
      });
    }
  })();
</script>

</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  /* ── Design tokens ─────────────────────────────────────── */
  :root {
    /* Portal shell tokens */
    --portal-bg:            #f9fafb;
    --portal-surface:       #ffffff;
    --portal-border:        #e5e7eb;
    --portal-text:          #111827;
    --portal-text-muted:    #6b7280;
    --portal-text-faint:    #9ca3af;
    /* Accent is aliased to the canonical brand blue (--lp-indigo) so the shell
       and content surfaces share one accent. The per-org override on <html>
       sets both --lp-indigo and --portal-accent together; these defaults match
       it. Do not reintroduce a separate accent value here. */
    --portal-accent:        var(--lp-indigo);
    --portal-accent-bg:     var(--lp-indigo-tint);
    --portal-hover-bg:      #f3f4f6;
    --portal-font-mono:     'Geist Mono', 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
    --portal-sidebar-width: 240px;
    --portal-topbar-height: 56px;

    /* --lp-* bridge — used by ask.astro and cowork.astro */
    --lp-indigo:       #3A56D2;
    --lp-indigo-tint:  rgba(58, 86, 210, 0.08);
    --lp-indigo-deep:  #263AA0;
    --lp-charcoal:     #262A36;
    --lp-steel:        #6C748A;
    --lp-steel-lt:     #A8AEC0;
    --lp-bg:           #F7F8FC;
    --lp-bg2:          #ECEEF5;
    --lp-border:       #E0E3EE;
    --lp-border2:      #C8CCDB;
    --lp-text:         #262A36;
    --lp-white:        #FFFFFF;
    --lp-font-mono:    'Geist Mono', 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
  }

  /* ── Per-act accent system (Explore · Deliver · Review) ──────
     Derives three harmonious accents from the live org accent (--lp-indigo) by
     hue rotation, so the dashboard grid, sidebar groups, and act sub-pages
     share one colour language that still tracks the org logo theme. Any element
     carrying data-act (or a descendant) can read var(--act) / var(--act-tint).
     Falls back to the single accent where relative-colour syntax is absent. */
  [data-act] { --act: var(--lp-indigo); --act-tint: var(--lp-indigo-tint); }
  @supports (color: hsl(from white h s l)) {
    [data-act="DELIVER"] { --act: hsl(from var(--lp-indigo) calc(h + 38) s l); }
    [data-act="REVIEW"]  { --act: hsl(from var(--lp-indigo) calc(h - 48) s l); }
  }
  @supports (color: color-mix(in srgb, red, blue)) {
    [data-act] { --act-tint: color-mix(in srgb, var(--act) 7%, var(--lp-white)); }
  }

  /* ── Body ──────────────────────────────────────────────── */
  .portal-body {
    font-family: 'Instrument Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: var(--portal-bg);
    color: var(--portal-text);
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
    line-height: 1.5;
  }

  /* ── Shell ─────────────────────────────────────────────── */
  .portal-shell { display: flex; min-height: 100vh; }

  /* ── Sidebar ───────────────────────────────────────────── */
  .portal-sidebar {
    width: var(--portal-sidebar-width);
    flex-shrink: 0;
    background: var(--portal-surface);
    border-right: 1px solid var(--portal-border);
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    z-index: 30;
    scrollbar-width: thin;
    scrollbar-color: var(--portal-border) transparent;
  }
  .portal-sidebar-inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }

  /* Logo */
  .portal-logo {
    height: var(--portal-topbar-height);
    display: flex;
    align-items: center;
    padding: 0 1.25rem;
    border-bottom: 1px solid var(--portal-border);
    flex-shrink: 0;
    overflow: hidden;
  }
  .portal-logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    min-width: 0;
  }
  .portal-logo-content {
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
  }
  /* Default KB logo (no org) */
  .portal-logo-img {
    height: 30px;
    width: auto;
    flex-shrink: 0;
    display: block;
  }
  /* Org logo (replaces KB logo when org has image) */
  .portal-logo-org-img {
    height: 30px;
    width: auto;
    max-width: 110px;
    object-fit: contain;
    border-radius: 4px;
    flex-shrink: 0;
    display: block;
  }
  /* Text column beside the logo */
  .portal-logo-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .portal-logo-callout {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--lp-indigo);
    line-height: 1.2;
    white-space: normal;
    word-break: break-word;
  }

  /* Main nav */
  .portal-nav {
    padding: 0.75rem 0.625rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }
  /* Three-act section groups */
  .portal-nav-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 0.5rem;
  }
  .portal-nav-group:first-of-type { margin-top: 0.25rem; }
  .portal-nav-group-label {
    font-family: var(--lp-font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--portal-text-faint);
    padding: 0.4rem 0.625rem 0.2rem;
    margin: 0;
  }
  .portal-nav-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.625rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--portal-text-muted);
    text-decoration: none;
    transition: background 0.1s, color 0.1s;
    border-left: 2px solid transparent;
  }
  .portal-nav-item:hover {
