---
/**
 * core/src/ui/SeoHead.astro — the head tags every portal page should carry.
 *
 * Split out so PortalLayout and PublicLayout emit identical signals rather than
 * drifting apart. Before this existed, PublicLayout had a title and a
 * conditional description and nothing else, so a shared link to any public page
 * rendered as a bare URL with no card.
 *
 * Indexing is opt-in. `noindex` defaults to true because the portal shell is an
 * authenticated app and most of it should never be indexed; a page earns
 * indexing by asking for it. That default is what keeps this safe to adopt in
 * portals that have not thought about SEO yet.
 */
export interface Props {
  /** Full title, already suffixed by the caller. */
  title: string;
  description?: string;
  /** Overrides the derived canonical. Pass only when a page has a preferred URL. */
  canonical?: string;
  /** Social card image, absolute or root-relative. */
  image?: string;
  /** og:type. "website" for most pages, "article" for content. */
  type?: string;
  noindex?: boolean;
  siteName?: string;
}

const {
  title,
  description = '',
  canonical,
  image,
  type = 'website',
  noindex = true,
  siteName,
} = Astro.props;

// Astro.site comes from the `site` key in astro.config, so the canonical always
// names one host even when the app answers on several. Query strings and hashes
// are dropped deliberately: they never identify a distinct page here.
const base = Astro.site ?? new URL(Astro.url.origin);
const href = new URL(canonical ?? Astro.url.pathname, base).href;
const imageHref = image ? new URL(image, base).href : null;
---

{noindex && <meta name="robots" content="noindex" />}
{description && <meta name="description" content={description} />}
<link rel="canonical" href={href} />

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:url" content={href} />
{description && <meta property="og:description" content={description} />}
{siteName && <meta property="og:site_name" content={siteName} />}
{imageHref && <meta property="og:image" content={imageHref} />}

<meta name="twitter:card" content={imageHref ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{imageHref && <meta name="twitter:image" content={imageHref} />}
